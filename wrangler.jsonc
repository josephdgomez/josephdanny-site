{
  "name": "josephdanny-site",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/portfolio", "/portfolio.html", "/api/*"]
  },
  "kv_namespaces": [
    { "binding": "CONTENT", "id": "85e25f37313f4f8b91af5d3c5f542b6c" }
  ],
  "observability": { "enabled": true }
}
